#!/bin/sh
# passess: never commit a secret.
# Install: git config core.hooksPath .githooks

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks is not installed (brew install gitleaks); commit refused." >&2
    exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner
status=$?
if [ $status -ne 0 ]; then
    echo "" >&2
    echo "pre-commit: a secret-shaped string was found; commit stopped." >&2
    echo "If it is a false positive, add its fingerprint to .gitleaksignore." >&2
    exit $status
fi
exit 0
